[Unit]
Description=Go HTTPs Server (Main)
After=network.target

[Service]
# даём время освободить порт
ExecStartPre=/bin/sleep 2

# запуск сервера
ExecStart=/root/neosync/http-server/bin/neosync.http-1.x.x-linux-amd64
WorkingDirectory=/root/neosync/http-server

# настройки перезапуска
Restart=on-failure
RestartSec=10s
TimeoutStopSec=10s
KillSignal=SIGINT

User=root
Group=root
LimitNOFILE=1048576
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
