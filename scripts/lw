#!/bin/bash

# bash lw 862843047104450 ~/neosync/services/tcp/logs --from 01.07.2026 --to 23.07.2026

set -euo pipefail

IMEI="${1:-}"
LOG_ROOT="${2:-}"
FROM_DATE=""
TO_DATE=""
OUTPUT=""
STDOUT=0

LOG_FILES=(server.log session.log warning.log errors.log)

usage() {
  cat <<'EOF'
Usage:
  extract_imei_logs.sh <IMEI> <logs_path> [options]

Options:
  --from DD.MM.YYYY   First day (inclusive, log line timestamp and log_* folder date)
  --to DD.MM.YYYY     Last day (inclusive)
  -o, --output FILE   Write merged log to FILE (default: ./<IMEI>-logs-<from>-<to>.log)
  --stdout            Print to stdout instead of file
  -h, --help          Show this help

Examples:
  bash scripts/extract_imei_logs.sh 862843047104450 ~/neosync/services/tcp/logs
  bash scripts/extract_imei_logs.sh 862843047104450 services/tcp/logs --from 01.07.2026 --to 15.07.2026
  bash scripts/extract_imei_logs.sh 862843047104450 services/tcp/logs --from 20.07.2026 --stdout | less

Notes:
  - Matches lines containing imei={<IMEI>} in shared logs (server.log, session.log, warning.log, errors.log).
  - Also includes legacy per-device files <IMEI>.log if present.
  - Reads both log_DDMMYYYY/ directories and log_DDMMYYYY.zip archives.
  - Output is sorted by [DD.MM.YYYY HH:MM:SS] from each line.
EOF
}

[[ -z "$IMEI" || -z "$LOG_ROOT" ]] && usage && exit 1
[[ ! -e "$LOG_ROOT" ]] && echo "Log path not found: $LOG_ROOT" >&2 && exit 1

shift 2 || true
while [[ $# -gt 0 ]]; do
  case "$1" in
    --from) FROM_DATE="$2"; shift 2 ;;
    --to)   TO_DATE="$2"; shift 2 ;;
    -o|--output) OUTPUT="$2"; shift 2 ;;
    --stdout) STDOUT=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown arg: $1" >&2; usage; exit 1 ;;
  esac
done

IMEI_PATTERN="imei={$IMEI}"
WORK="$(mktemp -d)"
RAW="$WORK/raw.log"
trap 'rm -rf "$WORK"' EXIT

: > "$RAW"

# DD.MM.YYYY -> YYYYMMDD
to_yyyymmdd() {
  local d="$1"
  [[ -z "$d" ]] && return 0
  local dd mm yyyy
  IFS='.' read -r dd mm yyyy <<< "$d"
  printf '%s%s%s' "$yyyy" "$mm" "$dd"
}

FROM_KEY="$(to_yyyymmdd "$FROM_DATE")"
TO_KEY="$(to_yyyymmdd "$TO_DATE")"

# log_DDMMYYYY or log_DDMMYYYY.zip -> YYYYMMDD
folder_date_key() {
  local name="${1%.zip}"
  if [[ "$name" =~ ^log_([0-9]{2})([0-9]{2})([0-9]{4})$ ]]; then
    printf '%s%s%s' "${BASH_REMATCH[3]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[1]}"
  fi
}

in_folder_range() {
  local key="$1"
  [[ -z "$key" ]] && return 1
  if [[ -n "$FROM_KEY" && "$key" < "$FROM_KEY" ]]; then
    return 1
  fi
  if [[ -n "$TO_KEY" && "$key" > "$TO_KEY" ]]; then
    return 1
  fi
  return 0
}

grep_imei_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  if [[ "$(basename "$file")" == "${IMEI}.log" ]]; then
    cat "$file" >> "$RAW"
  else
    grep -F "$IMEI_PATTERN" "$file" >> "$RAW" 2>/dev/null || true
  fi
}

grep_imei_stream() {
  grep -F "$IMEI_PATTERN" >> "$RAW" 2>/dev/null || true
}

collect_from_dir() {
  local dir="$1"
  local f base

  if [[ -f "$dir/${IMEI}.log" ]]; then
    cat "$dir/${IMEI}.log" >> "$RAW"
  fi

  for base in "${LOG_FILES[@]}"; do
    grep_imei_file "$dir/$base"
  done
}

collect_from_zip() {
  local zip="$1"
  local entry inner

  if unzip -l "$zip" 2>/dev/null | awk '{print $4}' | grep -qx "${IMEI}.log"; then
    unzip -p "$zip" "${IMEI}.log" >> "$RAW" 2>/dev/null || true
  fi

  while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    base="${entry##*/}"
    case "$base" in
      server.log|session.log|warning.log|errors.log)
        unzip -p "$zip" "$entry" 2>/dev/null | grep_imei_stream
        ;;
    esac
  done < <(unzip -l "$zip" 2>/dev/null | awk '/\.log$/ {print $4}')
}

# Single log file passed as root
if [[ -f "$LOG_ROOT" ]]; then
  grep_imei_file "$LOG_ROOT"
else
  shopt -s nullglob
  for path in "$LOG_ROOT"/log_* "$LOG_ROOT"/log_*.zip; do
    [[ -e "$path" ]] || continue
    name="$(basename "$path")"
    key="$(folder_date_key "$name")"
    in_folder_range "$key" || continue

    if [[ -d "$path" ]]; then
      collect_from_dir "$path"
    elif [[ -f "$path" && "$name" == *.zip ]]; then
      collect_from_zip "$path"
    fi
  done
  shopt -u nullglob

  # Fallback: search nested layout (older deployments)
  if [[ ! -s "$RAW" ]]; then
    find "$LOG_ROOT" \( -name "${IMEI}.log" -o -name 'server.log' -o -name 'session.log' -o -name 'warning.log' -o -name 'errors.log' \) -type f 2>/dev/null | while read -r f; do
      grep_imei_file "$f"
    done
    find "$LOG_ROOT" -name 'log_*.zip' -type f 2>/dev/null | while read -r z; do
      name="$(basename "$z")"
      key="$(folder_date_key "$name")"
      in_folder_range "$key" || continue
      collect_from_zip "$z"
    done
  fi
fi

if [[ ! -s "$RAW" ]]; then
  echo "No lines for IMEI $IMEI in $LOG_ROOT" >&2
  [[ -n "$FROM_DATE" || -n "$TO_DATE" ]] && echo "Date range: ${FROM_DATE:-*} .. ${TO_DATE:-*}" >&2
  exit 1
fi

SORTED="$WORK/sorted.log"
awk '
  function line_key(s,   a, t) {
    if (match(s, /^\[([0-9]{2})\.([0-9]{2})\.([0-9]{4}) ([0-9]{2}):([0-9]{2}):([0-9]{2})\]/, a)) {
      return a[3] a[2] a[1] a[4] a[5] a[6]
    }
    return ""
  }
  function day_key(s,   a) {
    if (match(s, /^\[([0-9]{2})\.([0-9]{2})\.([0-9]{4})/, a)) {
      return a[3] a[2] a[1]
    }
    return ""
  }
  {
    k = line_key($0)
    if (k == "") next
    dk = day_key($0)
    ok = 1
    if (from != "" && dk != "" && dk < from) ok = 0
    if (to != "" && dk != "" && dk > to) ok = 0
    if (ok) print k "\t" $0
  }
' from="$FROM_KEY" to="$TO_KEY" "$RAW" | sort -t $'\t' -k1,1 | cut -f2- > "$SORTED"

LINES=$(wc -l < "$SORTED" | tr -d ' ')
FIRST=$(head -1 "$SORTED" | sed -n 's/^\[\([^]]*\)\].*/\1/p')
LAST=$(tail -1 "$SORTED" | sed -n 's/^\[\([^]]*\)\].*/\1/p')

if [[ "$STDOUT" -eq 1 ]]; then
  echo "# IMEI=$IMEI root=$LOG_ROOT lines=$LINES range=${FIRST:-?} .. ${LAST:-?}" >&2
  cat "$SORTED"
  exit 0
fi

if [[ -z "$OUTPUT" ]]; then
  suffix="all"
  [[ -n "$FROM_DATE" || -n "$TO_DATE" ]] && suffix="${FROM_DATE:-start}-${TO_DATE:-end}"
  suffix="${suffix//./-}"
  OUTPUT="./${IMEI}-logs-${suffix}.log"
fi

{
  echo "# extract_imei_logs.sh"
  echo "# IMEI: $IMEI"
  echo "# Root: $LOG_ROOT"
  echo "# From: ${FROM_DATE:-*}"
  echo "# To:   ${TO_DATE:-*}"
  echo "# Lines: $LINES"
  echo "# Range: ${FIRST:-n/a} .. ${LAST:-n/a}"
  echo "# Generated: $(date '+%d.%m.%Y %H:%M:%S')"
  echo "# ---"
  cat "$SORTED"
} > "$OUTPUT"

echo "Saved $LINES lines -> $OUTPUT" >&2
echo "Time range: ${FIRST:-n/a} .. ${LAST:-n/a}" >&2
